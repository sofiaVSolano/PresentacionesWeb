ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# ---- Correo del formulario de contacto ----
# Con Gmail hace falta una contraseña de aplicación (16 letras), no la del
# correo: cuenta de Google -> Seguridad -> Verificación en 2 pasos ->
# Contraseñas de aplicaciones. Sin estas variables, en desarrollo el mensaje
# solo se escribe en el log; en producción el envío falla a la vista.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=

# SMTP_SSL=true si usas el puerto 465 en vez del 587
SMTP_SSL=false
# A dónde llegan los mensajes. Vacío = a la misma cuenta que los envía.
CONTACT_TO=
CONTACT_FROM_NAME=Portafolio de Sofía
# Mensajes por IP y hora
CONTACT_RATE_LIMIT=5
