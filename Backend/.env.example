ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# ---- Correo del formulario de contacto: Resend (principal) ----
# Camino principal, por HTTPS. Es el que funciona en Render, que no deja abrir
# conexiones SMTP salientes. La clave sale del panel de Resend -> API Keys y
# vive solo en el entorno: nunca en el código ni en el frontend.
RESEND_API_KEY=
# Remitente. El dominio tiene que estar verificado en Resend.
# Formato: "Portafolio de Sofía <contacto@tudominio.com>" o contacto@tudominio.com
# Para probar sin dominio propio: onboarding@resend.dev (solo entrega al correo
# con el que abriste la cuenta de Resend).
RESEND_FROM=
RESEND_TIMEOUT=15

# ---- Correo del formulario de contacto: SMTP (respaldo) ----
# Con Gmail hace falta una contraseña de aplicación (16 letras), no la del
# correo: cuenta de Google -> Seguridad -> Verificación en 2 pasos ->
# Contraseñas de aplicaciones. Sin ninguna de las dos vías, en desarrollo el
# mensaje solo se escribe en el log; en producción el envío falla a la vista.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=

# SMTP_SSL=true si usas el puerto 465 en vez del 587
SMTP_SSL=false
SMTP_TIMEOUT=20
# A dónde llegan los mensajes. Vacío = a SMTP_USER, así que si solo usas Resend
# (sin SMTP configurado) esta variable es obligatoria.
CONTACT_TO=
CONTACT_FROM_NAME=Portafolio de Sofía
# Mensajes por IP y hora
CONTACT_RATE_LIMIT=5
