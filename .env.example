BACKEND_PORT=8000
FRONTEND_PORT=5173

# Correo del formulario de contacto (solo para Docker Compose; en local cada
# carpeta usa su propio .env).

# Camino principal: Resend, por HTTPS. RESEND_FROM necesita un dominio
# verificado; para probar sirve onboarding@resend.dev.
RESEND_API_KEY=
RESEND_FROM=

# Respaldo: SMTP. La contraseña es la "de aplicación" de Gmail.
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=

CONTACT_TO=
